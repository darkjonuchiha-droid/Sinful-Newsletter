# Copy to .env and change the secrets before first run.
PORT=8710

# Password for the web admin UI login.
ADMIN_PASSWORD=change-me

# Shared secret between server and kiosk. Must match TOKEN in sinful-kiosk.lsl.
KIOSK_TOKEN=change-me-too

# Optional: override the SQLite file location (default: server/data/newsletter.db)
# DB_PATH=D:/somewhere/newsletter.db
